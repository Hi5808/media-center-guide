# Copy to .env and edit. NEVER commit the real .env (it's gitignored).

# --- identity / timezone ---
# Match PUID/PGID to the host user that OWNS the data dirs so hardlinks + perms work.
# Find yours with:  id -u   and   id -g
PUID=1000
PGID=1000
TZ=Pacific/Honolulu

# --- where things live on the HOST ---
# CONFIG_ROOT: per-service config/state (small, back this up)
# DATA_ROOT:   ONE filesystem holding torrents + media (same fs = instant hardlinks)
CONFIG_ROOT=./config
DATA_ROOT=/srv/data
# Expected layout, created on first run (or make them yourself owned by PUID:PGID):
#   ${DATA_ROOT}/torrents
#   ${DATA_ROOT}/media/tv
#   ${DATA_ROOT}/media/movies

# --- publish address ---
# 127.0.0.1 = localhost only (reach it via SSH tunnel or a reverse proxy).
# Set to your Tailscale IP to bind the UIs directly to the tailnet, e.g. 100.x.y.z
# Or 0.0.0.0 to listen on all interfaces and let UFW (tailscale0-only) gate access.
BIND_IP=127.0.0.1

# --- transmission RPC auth (download-only enforced via settings template) ---
DL_USER=admin
DL_PASS=change-me

# --- homepage ---
# Comma-separated host:port list the dashboard will answer to.
HOMEPAGE_ALLOWED_HOSTS=localhost:7575,127.0.0.1:7575

# --- Rockchip / RK3588 hardware transcode (optional) ---
# Uncomment the `devices:` line under the jellyfin service in compose.yaml and,
# on the host, ensure the render node exists (ls -l /dev/dri). On mainline RK3588
# use the rkmpp/rkvdec path; on vendor BSP kernels map the extra nodes too, e.g.:
#   /dev/dri:/dev/dri, /dev/mpp_service, /dev/rga, /dev/dma_heap
# Then in Jellyfin: Dashboard > Playback > enable VA-API (or RKMPP build).
